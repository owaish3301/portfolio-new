# Leave unset for local editing at /keystatic during npm run dev.
# Set to the GitHub repository containing THIS Next.js project for online editing.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=owaish3301/portfolio-new

# Generated by Keystatic's GitHub App setup. Copy to your hosting environment.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
